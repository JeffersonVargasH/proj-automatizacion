# n8n runs in Docker and exposes port 5678 on the host during local development.
N8N_GENERATE_WEBHOOK_URL=http://localhost:5678/webhook/creamas-generate
N8N_STATUS_WEBHOOK_URL=http://localhost:5678/webhook/status
# Textos con IA. Solo en el servidor; sin ninguna clave se usan plantillas.
# OpenAI (ChatGPT), Groq (plan gratuito) o xAI (Grok).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning
# Opcional: openai, groq o xai para forzar cuál va primero.
COPY_PROVIDER=
# Publica en Instagram, Facebook o WhatsApp Business con las credenciales de Meta guardadas en n8n.
N8N_PUBLISH_WEBHOOK_URL=http://localhost:5678/webhook/creamas-publish
# Optional shared secret validated by both n8n Webhook nodes.
N8N_WEBHOOK_TOKEN=replace-with-a-local-secret
