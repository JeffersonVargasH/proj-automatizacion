# n8n runs in Docker and exposes port 5678 on the host during local development.
N8N_GENERATE_WEBHOOK_URL=http://localhost:5678/webhook/creamas-generate
N8N_STATUS_WEBHOOK_URL=http://localhost:5678/webhook/status
# Optional shared secret validated by both n8n Webhook nodes.
N8N_WEBHOOK_TOKEN=replace-with-a-local-secret
# Secret used to sign the HttpOnly session cookie. Use a long random value.
AUTH_SECRET=replace-with-a-long-random-secret
# Payment provider adapter. Use test until a merchant account is configured.
PAYMENT_PROVIDER=test
